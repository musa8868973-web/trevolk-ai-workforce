########################################
# Trevolk AI Workforce — Backend Env
# Copy this file to `.env` and fill in
# real values. Never commit `.env`.
########################################

# ---------- Application ----------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=trevolk-ai-workforce-backend
LOG_LEVEL=info

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:3000

# ---------- Database (Prisma / sqlite) ----------
# Required for `npm run db:migrate`, `npm run db:seed`, and any request that
# touches the database. The app itself still boots without it (dev-safe),
# but the /health endpoint will report database: "unreachable".
DATABASE_URL="file:./dev.db"

# ---------- Authentication (Phase 3) ----------
# Required. Used to sign/verify access and refresh tokens (HS256).
# Generate strong random values, e.g.: openssl rand -hex 32
# Must be at least 16 characters; use two DIFFERENT secrets.
JWT_SECRET=replace_with_a_long_random_secret_min_16_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_min_16_chars
JWT_REFRESH_EXPIRES_IN=30d

# ---------- Redis (Background Jobs — BullMQ) ----------
REDIS_URL=redis://localhost:6379

# ---------- AI Providers ----------
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# ---------- Billing ----------
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---------- Google (Gmail / Calendar OAuth) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# ---------- WhatsApp ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---------- Managed Auth Provider (Clerk / Supabase) ----------
# Not used by Phase 3 (local email/password + JWT auth is implemented
# directly). Reserved for a future migration to a managed provider.
AUTH_PROVIDER=clerk
AUTH_PROVIDER_API_KEY=

# ---------- Integrations ----------
INTEGRATION_ENCRYPTION_KEY=

# ---------- System Emails ----------
PROJECT_EMAIL=trevolk.official@gmail.com
DEFAULT_SYSTEM_EMAIL=trevolk.official@gmail.com
