{
  "name": "trevolk-ai-workforce-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Trevolk AI Workforce — backend API (Express + TypeScript + Prisma).",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/server.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node -r tsconfig-paths/register --project prisma/tsconfig.seed.json prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios": "^1.19.0",
    "bullmq": "^6.0.10",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "googleapis": "^174.0.1",
    "helmet": "7.2.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "pino-pretty": "11.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "2.32.0",
    "jest": "29.7.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "prisma": "5.22.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
